# CakePHP specific files #
##########################
/config/app_local.php
/config/.env
/logs/*
/tmp/*
/vendor/*

# Projet #
##########
# Originaux uploadés et dérivés générés : jamais dans Git. L'ancien dépôt pesait
# 1,3 Go pour cette raison précise.
/storage/*
!/storage/.gitkeep
/webroot/media/*
!/webroot/media/.gitkeep

# ATTENTION : webroot/css/ et webroot/js/ sont des SOURCES, pas des artefacts de
# build. Le projet n'a plus d'étape de compilation — les bibliothèques viennent
# d'un CDN et le code du site est écrit directement dans ces fichiers. Ne pas les
# ignorer par réflexe « c'est dans webroot ».

