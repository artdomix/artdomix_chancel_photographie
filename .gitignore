# CakePHP specific files #
##########################
/config/app_local.php
/config/.env
/logs/*
/tmp/*
/vendor/*

# Projet #
##########
# Originaux uploadés et dérivés générés : jamais dans Git. L'ancien dépôt pesait
# 1,3 Go pour cette raison précise.
/storage/*
!/storage/.gitkeep
/webroot/media/*
!/webroot/media/.gitkeep

# ATTENTION : webroot/build/ est VOLONTAIREMENT versionné. L'hébergement mutualisé
# n'a pas Node, `npm run build` tourne en local ou en CI et la sortie est déployée
# telle quelle. Ne pas l'ignorer.

